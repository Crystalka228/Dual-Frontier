<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DualFrontier.Application.Tests</AssemblyName>
    <RootNamespace>DualFrontier.Application.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DualFrontier.Application\DualFrontier.Application.csproj" />
  </ItemGroup>
  <!--
    К10.3 v2 Item 42: К-L18 SimulationStateController tests exercise
    ModUnloadInterop.SetSimPaused which P/Invokes DualFrontier.Core.Native.dll.
    Native DLL must ride along into test output, mirrors Modding.Tests +
    Core.Interop.Tests pattern. Prefer Release build if available, fall
    back к Debug otherwise (so cmake build default works).
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\Release\DualFrontier.Core.Native.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\Release\DualFrontier.Core.Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DualFrontier.Core.Native.dll</Link>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\Debug\DualFrontier.Core.Native.dll"
          Condition="!Exists('$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\Release\DualFrontier.Core.Native.dll') and Exists('$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\Debug\DualFrontier.Core.Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DualFrontier.Core.Native.dll</Link>
    </None>
    <!-- Linux arm (permanent development environment, operator ruling 2026-08-26).
         The CMake/Ninja build is SINGLE-CONFIG, so the shared object lands at the
         build ROOT; there is no Release/ subdirectory to mirror the Windows path
         above. Sibling to the Windows item, not a replacement: the two Exists
         guards are mutually exclusive in practice, so exactly one arm applies on
         any given host and neither needs an OS condition. Canonical native build
         commands: DEVELOPMENT_HYGIENE.md section 3. -->
    <None Include="$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\DualFrontier.Core.Native.so"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\DualFrontier.Core.Native.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DualFrontier.Core.Native.so</Link>
    </None>
  </ItemGroup>
</Project>
