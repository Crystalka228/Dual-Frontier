<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DualFrontier.Runtime.Tests</AssemblyName>
    <RootNamespace>DualFrontier.Runtime.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DualFrontier.Runtime\DualFrontier.Runtime.csproj" />
    <!-- W3/G2 — covers the Launcher's RenderCommandDispatcher ambient-tint arm. The
         Launcher is an Exe; referencing it as a library imports no entry point. -->
    <ProjectReference Include="..\..\src\DualFrontier.Launcher\DualFrontier.Launcher.csproj" />
  </ItemGroup>

  <!--
    Native DLL must ride along into test output for FieldStorageBindingTests
    (V0.B Commit 15) which exercise the C ABI through NativeWorld P/Invoke.
    Mirrors the DualFrontier.Core.Interop.Tests pattern.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\Release\DualFrontier.Core.Native.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\Release\DualFrontier.Core.Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DualFrontier.Core.Native.dll</Link>
    </None>
    <!-- Linux arm (permanent development environment, operator ruling 2026-08-26).
         The CMake/Ninja build is SINGLE-CONFIG, so the shared object lands at the
         build ROOT; there is no Release/ subdirectory to mirror the Windows path
         above. Sibling to the Windows item, not a replacement: the two Exists
         guards are mutually exclusive in practice, so exactly one arm applies on
         any given host and neither needs an OS condition. Canonical native build
         commands: DEVELOPMENT_HYGIENE.md section 3. -->
    <None Include="$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\DualFrontier.Core.Native.so"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\DualFrontier.Core.Native.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DualFrontier.Core.Native.so</Link>
    </None>
  </ItemGroup>
</Project>
