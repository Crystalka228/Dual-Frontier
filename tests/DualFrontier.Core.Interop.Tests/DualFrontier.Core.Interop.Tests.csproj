<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DualFrontier.Core.Interop.Tests</AssemblyName>
    <RootNamespace>DualFrontier.Core.Interop.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DualFrontier.Contracts\DualFrontier.Contracts.csproj" />
    <ProjectReference Include="..\..\src\DualFrontier.Core.Interop\DualFrontier.Core.Interop.csproj" />
    <ProjectReference Include="..\..\src\DualFrontier.Components\DualFrontier.Components.csproj" />
    <ProjectReference Include="..\..\src\DualFrontier.Application\DualFrontier.Application.csproj" />
  </ItemGroup>

  <!--
    Native DLL must ride along into test output, mirroring the
    DualFrontier.Core.Benchmarks csproj pattern. Without this the test runner
    spawns a child process under a temp directory and gets DllNotFoundException.
    The condition guards against the pre-build state where the .dll has not
    yet been produced.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\Release\DualFrontier.Core.Native.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\Release\DualFrontier.Core.Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DualFrontier.Core.Native.dll</Link>
    </None>
    <!-- Linux arm (permanent development environment, operator ruling 2026-08-26).
         The CMake/Ninja build is SINGLE-CONFIG, so the shared object lands at the
         build ROOT; there is no Release/ subdirectory to mirror the Windows path
         above. Sibling to the Windows item, not a replacement: the two Exists
         guards are mutually exclusive in practice, so exactly one arm applies on
         any given host and neither needs an OS condition. Canonical native build
         commands: DEVELOPMENT_HYGIENE.md section 3. -->
    <None Include="$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\DualFrontier.Core.Native.so"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\DualFrontier.Core.Native.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DualFrontier.Core.Native.so</Link>
    </None>
  </ItemGroup>
</Project>
