<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DualFrontier.Modding.Tests</AssemblyName>
    <RootNamespace>DualFrontier.Modding.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
  <!--
    W4 — the four game references are EXPLICIT here now.

    They used to arrive transitively through DualFrontier.Application, which referenced all four
    for its composition root. That root is gone and the engine references none of them, so a test
    project that names a component, an event or a system has to say so itself. Test projects are
    outside the boundary ratchet's engine set by construction, so these edges are free: the law
    they enforce is about what SHIPS, and a test assembly ships with nothing.

    Naming them is also more honest than the transitive arrangement was. Modding.Tests exercises
    the vanilla scenario slice end to end, so it genuinely depends on the game's vocabulary; that
    dependency was previously invisible and would have vanished silently the moment the engine
    stopped supplying it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DualFrontier.Application\DualFrontier.Application.csproj" />
    <ProjectReference Include="..\..\src\DualFrontier.Components\DualFrontier.Components.csproj" />
    <ProjectReference Include="..\..\src\DualFrontier.Events\DualFrontier.Events.csproj" />
    <ProjectReference Include="..\..\src\DualFrontier.Systems\DualFrontier.Systems.csproj" />
    <ProjectReference Include="..\..\src\DualFrontier.AI\DualFrontier.AI.csproj" />
  </ItemGroup>
  <!--
    K8.2 v2 — native DLL must ride along into test output: these tests construct a real
    NativeWorld (the composer, the mod pipeline and the scenario slice all do) for InternedString
    interning on struct components. Without this, P/Invoke fails with DllNotFoundException.
    Mirrors the DualFrontier.Core.Interop.Tests + DualFrontier.Core.Benchmarks pattern.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\Release\DualFrontier.Core.Native.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\Release\DualFrontier.Core.Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DualFrontier.Core.Native.dll</Link>
    </None>
    <!-- Linux arm (permanent development environment, operator ruling 2026-08-26).
         The CMake/Ninja build is SINGLE-CONFIG, so the shared object lands at the
         build ROOT; there is no Release/ subdirectory to mirror the Windows path
         above. Sibling to the Windows item, not a replacement: the two Exists
         guards are mutually exclusive in practice, so exactly one arm applies on
         any given host and neither needs an OS condition. Canonical native build
         commands: DEVELOPMENT_HYGIENE.md section 3. -->
    <None Include="$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\DualFrontier.Core.Native.so"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\DualFrontier.Core.Native\build\DualFrontier.Core.Native.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DualFrontier.Core.Native.so</Link>
    </None>
  </ItemGroup>
  <!--
    The fixture mods are built solely so their assemblies and manifests
    end up in this project's bin/<config>/<tfm>/Fixtures/<assembly>/.
    ReferenceOutputAssembly=false keeps their types out of the test
    compilation so the test process never loads them into the default
    AssemblyLoadContext — that is critical for cross-ALC tests, which
    need to load each fixture into a freshly created context.
  -->
  <ItemGroup>
    <!-- W3 (PR #49 Codex review). The Weather pair and the gate-negative fixture deploy their
         artifacts into this project's Fixtures/ via their own AfterTargets="Build" copies. Without
         these references a clean targeted `dotnet test tests/DualFrontier.Modding.Tests` cannot
         produce those directories at all, and a solution-wide parallel build races test execution
         against them. Same non-compiling form as the fixtures below. -->
    <ProjectReference Include="..\..\mods\DualFrontier.Mod.Weather.Contracts\DualFrontier.Mod.Weather.Contracts.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\mods\DualFrontier.Mod.Weather\DualFrontier.Mod.Weather.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
