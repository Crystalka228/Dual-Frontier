<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DualFrontier.Application</AssemblyName>
    <RootNamespace>DualFrontier.Application</RootNamespace>
    <!-- K10.1 Item 15 — managed dispatcher uses unsafe function pointer
         delegate types к bind the [UnmanagedCallersOnly] callback. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!--
    W4 / boundary law B-1 — this project references ENGINE assemblies only.

    Four edges stood here until this wave: Components, Events, Systems and AI. They existed for
    one reason, the composition root, which registered the vanilla component types, built the
    walkability grid, spawned the starting colony and named the ten gameplay systems. All of that
    now arrives through the ordinary mod pipeline from dualfrontier.vanilla.scenario, so the
    engine no longer needs a word of game vocabulary and the edges are gone.

    The mod still needs those assemblies at runtime, and gets them from the host's default load
    context: the vanilla deploy target copies them beside the executable, which is exactly where
    they sat before this wave. See mods/Directory.Build.targets.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DualFrontier.Contracts\DualFrontier.Contracts.csproj" />
    <ProjectReference Include="..\DualFrontier.Core\DualFrontier.Core.csproj" />
    <ProjectReference Include="..\DualFrontier.Core.Interop\DualFrontier.Core.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DualFrontier.Modding.Tests" />
    <InternalsVisibleTo Include="DualFrontier.Launcher" />
    <!-- The benchmark project measures two internal ModIntegrationPipeline statics
         (TopoSortRegularMods, CheckDependencyPresence) as BDN companions to the xUnit
         scheduler-stress suite. It is bench-only and is not shipped.

         This grant used to be documented as covering the K7 spawn factories; that had stopped
         being true well before W4 (the benchmark mirrors their workload SHAPE by hand and never
         called them), and the factories themselves are gone with the composition root. -->
    <InternalsVisibleTo Include="DualFrontier.Core.Benchmarks" />
  </ItemGroup>
</Project>
